# =============================================================================
# Single development environment for the whole monolith.
# Docker Compose loads this file for the app container (env_file: .env.dev).
# Hostnames below are Docker Compose service names.
# =============================================================================

NODE_ENV=dev
PORT=3000
JWT_SECRET=dev-only-jwt-secret-change-me-in-production
JWT_EXPIRES_IN=12h

# PostgreSQL (booking write model)
DATABASE_URL=postgresql://lms:lms@postgres:5432/lms

# MongoDB (catalog source of truth, must be a replica set for Debezium CDC)
MONGO_URI=mongodb://mongo:27017/lms?replicaSet=rs0

# Redis (cache only, never the source of truth)
REDIS_URL=redis://redis:6379

# Kafka (outbox relay + Debezium CDC + notifications)
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=lms-monolith

# Elasticsearch (derived search index)
ELASTICSEARCH_NODE=http://elasticsearch:9200

# Topics. The Debezium MongoDB connector uses topic.prefix=catalog, so the
# change topic is catalog.<database>.<collection> = catalog.lms.books.
CATALOG_TOPIC=catalog.lms.books
CATALOG_DLQ_TOPIC=catalog.books.dlq
HOLD_TOPIC=hold.events
LOAN_TOPIC=loan.events

# Search index naming. The alias is what all readers/writers use.
ES_BOOKS_ALIAS=books
ES_BOOKS_INDEX=books_v1

# Library business rules (LLD section 5.3)
HOLD_TTL_HOURS=24
LOAN_PERIOD_DAYS=14
DAILY_FINE_RATE=0.50
MAX_FINE=20.00
MAX_ACTIVE_HOLDS_PER_USER=5
BLOCK_HOLDS_ABOVE_FINE=10.00

# Caches (arch.md section 5.8)
AVAILABILITY_TTL_SECONDS=60
SEARCH_CACHE_TTL_SECONDS=45
BOOK_CACHE_TTL_SECONDS=300

# Search paging caps (arch.md section 3.2)
MAX_SEARCH_SIZE=50
MAX_SEARCH_WINDOW=1000
